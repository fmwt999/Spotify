{
  "info": {
    "_postman_id": "7e2bdf42-1111-4e44-9f4d-4aab8c9c4004",
    "name": "Spotify Web API — ЛР4",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://api.spotify.com/v1"
    },
    {
      "key": "trackId",
      "value": "11dFghVXANMlKmJ8NB4b1k"
    },
    {
      "key": "accessToken",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Поиск трека",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/search?q=Twenty%20One%20Pilots&type=track",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200',()=>pm.response.to.have.status(200)); pm.test('Есть tracks.items',()=>pm.expect(pm.response.json().tracks.items).to.be.an('array'));"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Поиск с пустым q",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/search?q=&type=track",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Запрос обработан API',()=>pm.expect([200,400]).to.include(pm.response.code));"
            ]
          }
        }
      ]
    },
    {
      "name": "3. Несуществующий трек в поиске",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/search?q=xyzqwerty123notarealtrack&type=track",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200',()=>pm.response.to.have.status(200)); pm.test('Пустой результат',()=>pm.expect(pm.response.json().tracks.items).to.be.an('array').that.is.empty);"
            ]
          }
        }
      ]
    },
    {
      "name": "4. Получение трека",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/tracks/{{trackId}}",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200',()=>pm.response.to.have.status(200)); pm.test('Контракт трека',()=>{let x=pm.response.json(); ['id','name','artists','album','duration_ms'].forEach(k=>pm.expect(x).to.have.property(k));});"
            ]
          }
        }
      ]
    },
